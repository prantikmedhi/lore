{
  "mcpServers": {
    "lore": {
      "command": "uvx",
      "args": [
        "--from",
        "notebooklm-skill",
        "notebooklm-mcp"
      ],
      "env": {
        "NOTEBOOKLM_DEFAULT_LANGUAGE": "en",
        "NOTEBOOKLM_DEFAULT_FORMAT": "json",
        "NOTEBOOKLM_POWERED_MODE": "1"
      }
    }
  }
}
